{
  "name": "svl-sms",
  "version": "1.0.0",
  "description": "SVL School Management System - Desktop & Web",
  "main": "dist/electron/main.js",
  "homepage": "./",
  "author": "SVL-SMS Team",
  "license": "Proprietary",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/index.js",
    "generate-license": "node tools/generate-license.js",
    "build:frontend": "cd frontend && npm install --legacy-peer-deps && npm run build",
    "build:backend": "tsc --project tsconfig.json",
    "build:electron": "tsc --project tsconfig.electron.json",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run build:electron && electron .\"",
    "electron-build": "npm run build && npm run build:electron && electron-builder",
    "electron-build:win": "npm run electron-build -- --win",
    "electron-build:mac": "npm run electron-build -- --mac",
    "electron-build:linux": "npm run electron-build -- --linux",
    "electron-build:all": "npm run electron-build -- --publish always",
    "electron-pack": "electron-builder --dir",
    "electron-dist": "electron-builder"
  },
  "build": {
    "appId": "com.svl-sms.desktop",
    "productName": "SVL-SMS",
    "files": [
      "dist/electron/main.js",
      "dist/electron/preload.js",
      "frontend/dist/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "certificateAssetPassword": null
    },
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": "20.x"
  }
}
