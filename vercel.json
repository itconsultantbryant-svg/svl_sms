{
  "version": 2,
  "name": "svl-sms-frontend",
  "public": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_API_URL": {
      "description": "Backend API URL",
      "default": "https://svl-sms-backend.onrender.com/api"
    },
    "VITE_APP_NAME": {
      "description": "Application name",
      "default": "SVL School Management System"
    },
    "VITE_APP_VERSION": {
      "description": "Application version",
      "default": "1.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://svl-sms-backend.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "content-encoding",
          "value": "gzip"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(?!api)(.*)$",
      "status": 200,
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "frontend/**/*.js": {
      "maxDuration": 60
    }
  },
  "regions": ["sfo1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
