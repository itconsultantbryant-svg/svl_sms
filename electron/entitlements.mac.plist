<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow app to run in sandbox -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Allow network connections -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Allow file system access -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>

  <!-- Allow local networking -->
  <key>com.apple.security.network.local</key>
  <true/>

  <!-- Allow subprocesses (for spawning backend) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow app to work with pasteboard -->
  <key>com.apple.security.pasteboard.read</key>
  <true/>
  <key>com.apple.security.pasteboard.write</key>
  <true/>

  <!-- Allow camera/microphone (if needed) -->
  <!--
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.microphone</key>
  <true/>
  -->

  <!-- Allow printing -->
  <key>com.apple.security.print</key>
  <true/>
</dict>
</plist>
