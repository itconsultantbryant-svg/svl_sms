################################################################################
# SVL-SMS Environment Configuration
################################################################################
# Copy this file to .env and fill in the values for your environment
# IMPORTANT: Never commit .env to version control!
# IMPORTANT: Generate new secrets for production using openssl or similar tools

################################################################################
# Backend Configuration
################################################################################

# Node environment (development|staging|production)
NODE_ENV=production

# Server port (Render default: 10000, Local: 3001)
PORT=10000

################################################################################
# Database Configuration
################################################################################

# Path to SQLite database file
# Local: ./data/svl-sms.db
# Render: Managed by Render (set DB_PATH if needed for local backup)
DB_PATH=./data/svl-sms.db

# For Render PostgreSQL/SQLite (optional, if using managed database)
DATABASE_URL=

################################################################################
# Authentication & Security
################################################################################

# JWT Secret for signing authentication tokens
# CRITICAL: Change this to a secure random string in production!
# Generate using: openssl rand -base64 32
# DO NOT use the default value in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-openssl-rand-base64-32

# License system private key (for license validation)
# CRITICAL: This must be a valid private key in production
# Generate using: node tools/generate-license.js
LICENSE_PRIVATE_KEY=your-private-key-here-generate-using-tools-generate-license-js

################################################################################
# CORS & Domains
################################################################################

# CORS Origins (comma-separated URLs where frontend is deployed)
# Examples:
#   Development: http://localhost:5173,http://localhost:3000
#   Production: https://svl-sms-frontend.onrender.com,https://your-domain.com
CORS_ORIGINS=https://svl-sms-frontend.onrender.com,https://www.your-domain.com,http://localhost:3000,http://localhost:5173

# Frontend URL (for redirects and links)
FRONTEND_URL=https://svl-sms-frontend.onrender.com

################################################################################
# Render-Specific Configuration
################################################################################

# Render external URL (auto-populated on Render)
# Format: https://<service-name>.onrender.com
RENDER_EXTERNAL_URL=https://svl-sms-backend.onrender.com

# Render service IDs (for CI/CD deployments)
RENDER_SERVICE_ID_BACKEND=
RENDER_SERVICE_ID_FRONTEND=

################################################################################
# Frontend Configuration (Vite)
################################################################################

# Backend API URL for frontend to connect to
# Development: http://localhost:10000/api
# Production: https://svl-sms-backend.onrender.com/api
VITE_API_URL=https://svl-sms-backend.onrender.com/api

# Application metadata
VITE_APP_NAME=SVL School Management System
VITE_APP_VERSION=1.0.0

################################################################################
# Logging & Debugging
################################################################################

# Debug mode (set to true for verbose logging)
DEBUG=false

# Log level (error|warn|info|debug|trace)
LOG_LEVEL=info

################################################################################
# Feature Flags
################################################################################

# Enable demo mode (allows login without full verification)
DEMO_MODE=false

# Enable license validation
ENABLE_LICENSE_VALIDATION=true

# Enable RBAC (Role-Based Access Control)
ENABLE_RBAC=true

################################################################################
# Production Checklist
################################################################################

# Before deploying to production:
# ✓ Generate new JWT_SECRET: openssl rand -base64 32
# ✓ Generate LICENSE_PRIVATE_KEY: node tools/generate-license.js
# ✓ Update CORS_ORIGINS with your frontend domain(s)
# ✓ Update FRONTEND_URL with your frontend domain
# ✓ Set NODE_ENV=production
# ✓ Review and update all environment variables
# ✓ Test authentication flows
# ✓ Verify database backups are configured
# ✓ Enable HTTPS/SSL
# ✓ Set up monitoring and alerts

################################################################################
# Notes
################################################################################

# Database Selection:
#   - SQLite (default): Good for small to medium deployments, included by default
#   - PostgreSQL: Better for large deployments, scale horizontally
#   - MySQL: Alternative option if needed

# Security Recommendations:
#   - Use strong, random JWT_SECRET (minimum 32 characters)
#   - Rotate secrets periodically in production
#   - Never commit secrets to version control
#   - Use environment variables for all sensitive data
#   - Enable HTTPS/SSL in production
#   - Set CORS_ORIGINS to specific domains (never use *)
#   - Regular security audits and updates

# Performance Optimization:
#   - Use production-grade database (PostgreSQL for production)
#   - Enable caching headers
#   - Use CDN for static assets
#   - Monitor API response times
#   - Set up load balancing if needed
