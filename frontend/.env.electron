# Electron desktop build configuration.
#
# Intentionally EMPTY VITE_API_URL. In the desktop build the frontend must NOT
# bake in a remote server URL — instead it discovers the local bundled backend
# URL (with its dynamically assigned port) at runtime via the preload bridge
# (window.api.getApiUrl()). This file is loaded by Vite's build:electron script
# (--mode electron) through prepare-electron-dist.js.
VITE_API_URL=
